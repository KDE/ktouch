{
    "id": "org.kde.ktouch",
    "branch": "master",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "ktouch",
    "tags": [
        "nightly"
    ],
    "desktop-file-name-suffix": " (Nightly)",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/lib/*.la",
        "/lib/cmake",
        "/lib/pkgconfig"
    ],
    "modules": [
        {
            "name": "libxkbfile",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://xorg.freedesktop.org/releases/individual/lib/libxkbfile-1.2.0.tar.xz",
                    "sha256": "7f71884e5faf56fb0e823f3848599cf9b5a9afce51c90982baeb64f635233ebf",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 1781,
                        "stable-only": true,
                        "url-template": "https://xorg.freedesktop.org/releases/individual/lib/libxkbfile-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "kqtquickcharts",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "git",
                    "url": "https://invent.kde.org/kde/kqtquickcharts.git"
                }
            ]
        },
        {
            "name": "ktouch",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
